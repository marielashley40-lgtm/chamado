# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Opcional - caso queira salvar direto na sua nuvem Supabase)
# Ao configurar estas variáveis, o sistema persiste os chamados automaticamente no seu projeto Supabase.
# Se não estiverem configuradas, o sistema usa armazenamento local resiliente automático.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

